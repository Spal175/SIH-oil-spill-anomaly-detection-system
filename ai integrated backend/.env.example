# Copy to `.env` and fill in real values. Never commit `.env`.

# Core
APP_NAME=oil-spill-api
APP_ENV=development
DEBUG=true

# Model (checkpoint lives at the project root)
MODEL_PATH=oil_spill_unet.pt
ML_DEVICE=auto
ML_THRESHOLD=0.5
MIN_CONNECTED_AREA=8

# Database (plain PostgreSQL, no PostGIS needed; schema via `alembic upgrade head`)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/oil_spill

# AIS WebSocket source (mock server at ws://localhost:8001/ais)
AIS_WS_URL=ws://localhost:8001/ais
AIS_TOKEN=
AIS_RECONNECT_BASE_SECONDS=1.0
AIS_RECONNECT_MAX_SECONDS=30.0

# Vessel candidate search around a detected spill (spatial + temporal)
AIS_SEARCH_RADIUS_KM=10
AIS_TIME_BEFORE_MINUTES=60
AIS_TIME_AFTER_MINUTES=0
AIS_APPROACH_FACTOR=0.5